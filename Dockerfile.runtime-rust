# codegraph-runtime-rust: the `toolchain: python+rust` workspace image.
#
# A SUPERSET of codegraph-runtime (Dockerfile.runtime): it starts FROM that
# image, so every Python/JS tool, the hunt agent, uid 1000 `coder`, HOME and
# CI=1 are inherited unchanged, and only the Rust layer is added here. A
# python+rust workspace can therefore still run everything a python one can.
#
# Selected per workspace by KubernetesContainerProvisioner when the create
# request says `toolchain: "python+rust"` (image map PROVISIONER_IMAGES_JSON,
# see src/core/toolchain.py). `toolchain` omitted / "python" never sees this
# image.
#
# What it adds, and why each piece is here rather than fetched at run time:
#   * rustup + toolchain 1.99.0 (+ clippy, rustfmt). 1.99.0 is the toolchain
#     strata_rag pins for gitops rust-service.yml (`rust_toolchain: "1.99.0"`),
#     so the agent builds with what the target's CI will build with. The pod
#     runs as uid 1000 and RUSTUP_HOME is root-owned, so a toolchain cannot be
#     installed at run time — it must be baked.
#   * cargo-nextest, cargo-audit, cargo-deny, sqlx-cli: PREBUILT release
#     binaries, each pinned by version AND sha256. Never `cargo install`: a
#     from-source build of these needs more RAM than a dev docker VM has and
#     makes the image build depend on compiling ~400 crates.
#       - sqlx-cli has no upstream binary release; the artifact is the
#         cargo-quickinstall build (the source cargo-binstall uses), pinned by
#         its GitHub release asset digest.
#   * PGDG postgresql-18 server + `ws-pg` (scripts/ws-pg): a throwaway Postgres
#     on 127.0.0.1 inside the pod, data under /tmp (an emptyDir), so sqlx
#     migrations and DB tests run next to the checkout. 18 matches the
#     server version the deployment targets (18.4).
#
# Build (locally):
#   docker build -f Dockerfile.runtime -t codegraph-runtime:local .
#   docker build -f Dockerfile.runtime-rust \
#     --build-arg BASE_IMAGE=codegraph-runtime:local -t codegraph-runtime-rust:local .
# CI: .github/workflows/runtime-image.yaml builds this right after the python
# image, with BASE_IMAGE set to the tag that job just pushed.
ARG BASE_IMAGE=ghcr.io/nonagenticai/codegraph-runtime:latest

FROM ${BASE_IMAGE}

# Everything below needs root; the base ends at USER 1000.
USER root

ARG TARGETARCH
ARG RUST_TOOLCHAIN=1.99.0
ARG RUSTUP_VERSION=1.29.2
ARG RUSTUP_SHA256_AMD64=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
ARG RUSTUP_SHA256_ARM64=a9c168dbea81a84671c6b7a5c1795cb0eb699020110d107ddfca427bd797e697
ARG NEXTEST_VERSION=0.9.149
ARG NEXTEST_SHA256_AMD64=d65c7f14bcb5c1566d1ecd534c5da8dedb81ba58586e478b0ab81c877d2bd8ad
ARG NEXTEST_SHA256_ARM64=533c9b431c2bb1dcb216e02e474263db0cdcd556373b72cc34830fb417058a6b
ARG CARGO_AUDIT_VERSION=0.22.2
ARG CARGO_AUDIT_SHA256_AMD64=7fb9497f8594b389e5fce5ef9b92db08432996895b2e0c5a0167a69ed445c428
ARG CARGO_AUDIT_SHA256_ARM64=c6603814ddaa45e51263dafd31c0ac98808f688d26f7395804f9670b0fd599dd
ARG CARGO_DENY_VERSION=0.20.2
ARG CARGO_DENY_SHA256_AMD64=9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f
ARG CARGO_DENY_SHA256_ARM64=995c82be0defc7a025cae49a2aa2644ce8245c9a3318fc4103907c6a285e8c7d
ARG SQLX_CLI_VERSION=0.9.0
ARG SQLX_CLI_SHA256_AMD64=c35eb855b359ffb2672e7830b085e62906a292c622eb3de9119ab234792e174e
ARG SQLX_CLI_SHA256_ARM64=620746a428dbbd642e544e72b984352c756f520582c687fa5ccdeee971758ade
ARG PG_MAJOR=18

# Toolchain lives in root-owned, world-readable dirs; the per-user cargo cache
# (registry index, crate sources, git deps) goes to a writable CARGO_HOME under
# HOME at run time — see the ENV block at the end.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_INSTALL_ROOT=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/lib/postgresql/${PG_MAJOR}/bin:${PATH}

# Build deps for crates that compile C (cc / ring / openssl-sys / libpq-sys):
# gcc + libc headers + pkg-config + libssl-dev. Without a linker `cargo build`
# fails on the first crate, std alone does not link. curl + ca-certificates +
# gnupg for the downloads and the PGDG key.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# sha256-pinned download helper: picks the arch-specific pin, fails the build on
# a mismatch (sha256sum -c exits non-zero).
RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    '# fetch-pinned <url> <sha256> <out>' \
    'curl -fsSL --retry 5 --retry-delay 3 -o "$3" "$1"' \
    'echo "$2  $3" | sha256sum -c -' \
    > /usr/local/sbin/fetch-pinned && chmod 0755 /usr/local/sbin/fetch-pinned

# rustup (pinned rustup-init, sha256-checked) → exact toolchain, minimal
# profile + clippy + rustfmt. `--default-toolchain` writes settings.toml under
# RUSTUP_HOME, so the read-only proxies resolve 1.99.0 for uid 1000 without
# rustup ever needing to write.
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) T=x86_64-unknown-linux-gnu;  S="${RUSTUP_SHA256_AMD64}" ;; \
      arm64) T=aarch64-unknown-linux-gnu; S="${RUSTUP_SHA256_ARM64}" ;; \
      *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    fetch-pinned "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${T}/rustup-init" "$S" /tmp/rustup-init; \
    chmod +x /tmp/rustup-init; \
    CARGO_HOME=/usr/local/cargo /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-toolchain "${RUST_TOOLCHAIN}" --component clippy --component rustfmt; \
    rm -f /tmp/rustup-init; \
    chmod -R a+rX /usr/local/rustup /usr/local/cargo; \
    rustc --version | grep -q "^rustc ${RUST_TOOLCHAIN} "

# Prebuilt cargo subcommands + sqlx, each version- and sha256-pinned per arch.
# musl builds where upstream publishes them (static, no glibc coupling to the
# python:3.14-slim base).
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) A=x86_64;  NX="${NEXTEST_SHA256_AMD64}"; AU="${CARGO_AUDIT_SHA256_AMD64}"; \
             DE="${CARGO_DENY_SHA256_AMD64}"; SQ="${SQLX_CLI_SHA256_AMD64}" ;; \
      arm64) A=aarch64; NX="${NEXTEST_SHA256_ARM64}"; AU="${CARGO_AUDIT_SHA256_ARM64}"; \
             DE="${CARGO_DENY_SHA256_ARM64}"; SQ="${SQLX_CLI_SHA256_ARM64}" ;; \
      *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    # cargo-audit publishes no aarch64 musl build; gnu is fine on trixie glibc.
    if [ "$A" = x86_64 ]; then AUT=x86_64-unknown-linux-musl; else AUT=aarch64-unknown-linux-gnu; fi; \
    d="$(mktemp -d)"; cd "$d"; \
    fetch-pinned "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${NEXTEST_VERSION}/cargo-nextest-${NEXTEST_VERSION}-${A}-unknown-linux-musl.tar.gz" "$NX" nextest.tgz; \
    fetch-pinned "https://github.com/rustsec/rustsec/releases/download/cargo-audit%2Fv${CARGO_AUDIT_VERSION}/cargo-audit-${AUT}-v${CARGO_AUDIT_VERSION}.tgz" "$AU" audit.tgz; \
    fetch-pinned "https://github.com/EmbarkStudios/cargo-deny/releases/download/${CARGO_DENY_VERSION}/cargo-deny-${CARGO_DENY_VERSION}-${A}-unknown-linux-musl.tar.gz" "$DE" deny.tgz; \
    fetch-pinned "https://github.com/cargo-bins/cargo-quickinstall/releases/download/sqlx-cli-${SQLX_CLI_VERSION}/sqlx-cli-${SQLX_CLI_VERSION}-${A}-unknown-linux-musl.tar.gz" "$SQ" sqlx.tgz; \
    for f in nextest audit deny sqlx; do mkdir "x-$f"; tar -xzf "$f.tgz" -C "x-$f"; done; \
    for b in cargo-nextest cargo-audit cargo-deny sqlx cargo-sqlx; do \
      p="$(find "$d" -type f -name "$b" | head -n1)"; \
      [ -n "$p" ] || { echo "binary $b not found in its release archive" >&2; exit 1; }; \
      install -m 0755 "$p" "/usr/local/cargo/bin/$b"; \
    done; \
    cd /; rm -rf "$d"

# PGDG signing key, pinned by FULL fingerprint (the published ACCC4CF8 key,
# "PostgreSQL Debian Repository"; verified 2026-10-25 against both
# postgresql.org/media/keys/ACCC4CF8.asc and keyserver.ubuntu.com). The key is
# refused unless its fingerprint matches exactly.
ARG PGDG_KEY_FINGERPRINT=B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8
# Exact server/client package version (trixie-pgdg, amd64 + arm64 both carry
# it). PGDG keeps older builds in the pool, so the pin stays installable after
# a newer minor lands; bump deliberately.
ARG PGDG_CODENAME=trixie
ARG PG_PACKAGE_VERSION=18.6-1.pgdg13+2

# PGDG postgresql-18. The Debian package would otherwise create and start a
# `main` cluster owned by `postgres` at install time; a workspace never uses
# that one (ws-pg runs its own as uid 1000), so cluster creation is disabled
# BEFORE the install.
RUN set -eu; \
    . /etc/os-release; \
    install -d -m 0755 /usr/share/postgresql-common/pgdg /etc/postgresql-common; \
    k="$(mktemp -d)"; \
    curl -fsSL --retry 5 -o "$k/pgdg.asc" https://www.postgresql.org/media/keys/ACCC4CF8.asc; \
    fpr="$(gpg --batch --show-keys --with-colons "$k/pgdg.asc" | awk -F: '$1 == "fpr" { print $10 }')"; \
    [ "$fpr" = "${PGDG_KEY_FINGERPRINT}" ] \
      || { echo "PGDG signing key fingerprint mismatch: got '$fpr'" >&2; exit 1; }; \
    gpg --batch --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg "$k/pgdg.asc"; \
    rm -rf "$k"; \
    [ "${VERSION_CODENAME}" = "${PGDG_CODENAME}" ] \
      || { echo "base is ${VERSION_CODENAME}, PGDG pins are for ${PGDG_CODENAME}" >&2; exit 1; }; \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list; \
    printf 'create_main_cluster = false\n' > /etc/postgresql-common/createcluster.conf; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      "postgresql-${PG_MAJOR}=${PG_PACKAGE_VERSION}" "postgresql-client-${PG_MAJOR}=${PG_PACKAGE_VERSION}"; \
    rm -rf /var/lib/apt/lists/*; \
    initdb --version | grep -q " ${PG_MAJOR}\."

COPY scripts/ws-pg /usr/local/bin/ws-pg
RUN chmod 0755 /usr/local/bin/ws-pg

# Build-time smoke: a broken toolchain never reaches the registry.
RUN cargo --version && rustc --version && cargo clippy --version && cargo fmt --version \
    && cargo nextest --version && cargo audit --version && cargo deny --version \
    && sqlx --version && psql --version && initdb --version

# Run-time environment for uid 1000:
#   CARGO_HOME — writable per-user cache (registry index, sources). The pod
#     sets HOME=/home/coder; binaries stay on PATH from /usr/local/cargo/bin.
#   PGHOST/PGPORT — a bare `psql` / libpq client goes to the ws-pg instance
#     over loopback TCP instead of a socket dir uid 1000 cannot write.
#   CARGO_BUILD_JOBS is NOT set: cargo sizes to the cgroup CPU limit itself.
ENV CARGO_HOME=/home/coder/.cargo \
    PGHOST=127.0.0.1 \
    PGPORT=5432

USER 1000:1000

CMD ["sleep", "infinity"]
